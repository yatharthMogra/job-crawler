# Copy to parallel_gemini_drain.env and fill in your keys (do not commit).
#
#   cp scripts/parallel_gemini_drain.env.example scripts/parallel_gemini_drain.env
#
# Probe keys (one request each, checks daily quota):
#   python scripts/parallel_gemini_drain_today.py --probe-keys
#
# v6 clearance + role_intent backfill:
#   python scripts/backfill_clearance_role_intent.py --reset-stuck --skip-drain
#   python scripts/parallel_gemini_drain_today.py --launch-all --reset-stuck
#
# Optional overrides (defaults use job_ingestion baseline — conservative):
#   EXTRACTION_VERSION=v6
#   PARALLEL_ENRICHMENT_LLM_MAX_RPM=10
#
# Baseline batching (from app config, not overridden here):
#   micro_batch_size=16, max_input_tokens_per_batch=14000,
#   window_token_budget=200000, window_seconds=45, max_batches_per_window=20

