DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobingestion
NOTIFICATION_CADENCE_HOURS=24
# Optional: overrides NOTIFICATION_CADENCE_HOURS when set (e.g. 720 for 12 hours)
# NOTIFICATION_CADENCE_MINUTES=
# Cloud Run API: false | Home notification worker: true
ENABLE_NOTIFICATION_SCHEDULER=true
NOTIFICATION_RETRIEVAL_LIMIT=500
# Alias for dashboard recommendation retrieval cap (defaults to NOTIFICATION_RETRIEVAL_LIMIT)
RECOMMENDATION_RETRIEVAL_LIMIT=500
RECOMMENDATION_POOL_FLOOR_RATIO=0.1
RECOMMENDATION_MAX_COMPANY_SHARE=0.03
RECOMMENDATION_COMPANY_UNLOCK_BATCH=5
NOTIFICATION_JOBS_PER_EMAIL=4
NOTIFICATION_MAX_JOBS_PER_COMPANY=1
# Must match job_ingestion JOB_MAX_AGE_DAYS
JOB_MAX_AGE_DAYS=7
NOTIFICATION_MIN_JOBS_TO_SEND=1
DIGEST_SCHEDULER_POLL_MINUTES=15
COMPANY_WATCH_POLL_MINUTES=3
COMPANY_WATCH_BATCH_SIZE=50
DEFAULT_DIGEST_CADENCE_HOURS=24
DEFAULT_DIGEST_TOP_K=4
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Career Match AI <noreply@example.com>
SCORE_CAPABILITY_WEIGHT=0.40
SCORE_SKILL_WEIGHT=0.25
SCORE_LOCATION_WEIGHT=0.20
SCORE_COMPENSATION_WEIGHT=0.15
LOG_LEVEL=INFO
# Production (Cloud Run): add your Vercel URL
# CORS_ORIGINS=https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000
DOMAIN_FILTER_ENABLED=false
ROLE_INTENT_FILTER_ENABLED=true
CLEARANCE_FILTER_ENABLED=true
SPONSORSHIP_SCORE_ENABLED=false
SCORE_SPONSORSHIP_WEIGHT=0.12
EXPERIENCE_TIER_VISIBILITY_ENABLED=false
EXPERIENCE_TIER_VISIBILITY_CEILING=SENIOR
EXPERIENCE_TIER_SCORE_ENABLED=false
SCORE_EXPERIENCE_TIER_WEIGHT=0.15
