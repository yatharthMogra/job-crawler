DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobingestion
NOTIFICATION_CADENCE_HOURS=24
# Optional: overrides NOTIFICATION_CADENCE_HOURS when set (e.g. 720 for 12 hours)
# NOTIFICATION_CADENCE_MINUTES=
# Cloud Run API: false | Home notification worker: true
ENABLE_NOTIFICATION_SCHEDULER=true
NOTIFICATION_RETRIEVAL_LIMIT=500
# Alias for dashboard recommendation retrieval cap (defaults to NOTIFICATION_RETRIEVAL_LIMIT)
RECOMMENDATION_RETRIEVAL_LIMIT=500
RECOMMENDATION_POOL_FLOOR_RATIO=0.1
RECOMMENDATION_MAX_JOBS_PER_COMPANY=5
RECOMMENDATION_COMPANY_UNLOCK_BATCH=5
NOTIFICATION_JOBS_PER_EMAIL=4
NOTIFICATION_MAX_JOBS_PER_COMPANY=1
# Must match job_ingestion JOB_MAX_AGE_DAYS
JOB_MAX_AGE_DAYS=7
NOTIFICATION_MIN_JOBS_TO_SEND=1
DIGEST_SCHEDULER_POLL_MINUTES=15
COMPANY_WATCH_POLL_MINUTES=3
COMPANY_WATCH_BATCH_SIZE=50
COMPANY_WATCH_MAX_JOBS_PER_EMAIL=5
# Personal score floor for Company Watch; jobs below this are never emailed
COMPANY_WATCH_MIN_SCORE=0.5
DEFAULT_DIGEST_CADENCE_HOURS=24
DEFAULT_DIGEST_TOP_K=4
RESEND_API_KEY=
EMAIL_FROM=Job Scout <notifications@job-scout.dev>
SCORE_CAPABILITY_WEIGHT=0.40
SCORE_SKILL_WEIGHT=0.25
SCORE_LOCATION_WEIGHT=0.20
SCORE_COMPENSATION_WEIGHT=0.15
LOG_LEVEL=INFO
# Production (Cloud Run): add your Vercel URL
# CORS_ORIGINS=https://your-app.vercel.app
# Links in notification emails (manage prefs, unsubscribe, view jobs)
APP_BASE_URL=http://localhost:3000
# Production home worker: APP_BASE_URL=https://job-scout.dev
DOMAIN_FILTER_ENABLED=false
ROLE_INTENT_FILTER_ENABLED=true
CLEARANCE_FILTER_ENABLED=true
SPONSORSHIP_SCORE_ENABLED=false
SCORE_SPONSORSHIP_WEIGHT=0.12
EXPERIENCE_TIER_VISIBILITY_ENABLED=false
EXPERIENCE_TIER_VISIBILITY_CEILING=SENIOR
EXPERIENCE_TIER_SCORE_ENABLED=false
SCORE_EXPERIENCE_TIER_WEIGHT=0.15
# ATS fit score (resume vs job content); enable after IDF corpus + embeddings backfill
ATS_FIT_ENABLED=false
ATS_FIT_BM25_WEIGHT=0.50
ATS_FIT_SEMANTIC_WEIGHT=0.25
ATS_FIT_STRUCTURAL_WEIGHT=0.25
# Qualification fit: shadow first, then set ENABLED=true and SHADOW_MODE=false after calibration
QUALIFICATION_FIT_ENABLED=false
QUALIFICATION_FIT_SHADOW_MODE=true
QUALIFICATION_FIT_REQUIRED_SKILL_WEIGHT=0.80
QUALIFICATION_FIT_PREFERRED_SKILL_WEIGHT=0.20
QUALIFICATION_FIT_SKILL_WEIGHT=0.45
QUALIFICATION_FIT_CAPABILITY_WEIGHT=0.30
QUALIFICATION_FIT_STRUCTURAL_WEIGHT=0.25
COVERAGE_FUZZY_BM25_WEIGHT=0.50
COVERAGE_FUZZY_SEMANTIC_WEIGHT=0.50
# RRF + cache-backed pagination (requires Redis)
RECOMMENDATION_RRF_ENABLED=true
RECOMMENDATION_RRF_K=60
RECOMMENDATION_PAGE_SIZE=40
RECOMMENDATION_PAGE_SIZE_MAX=100
RECOMMENDATION_CACHE_TTL_SECONDS=1800
# Required when RECOMMENDATION_RRF_ENABLED=true (e.g. redis://localhost:6379/0 or Upstash URL)
REDIS_URL=
