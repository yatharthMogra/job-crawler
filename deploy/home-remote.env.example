# Copy to deploy/home-remote.env (gitignored) and adjust if needed.
#
#   cp deploy/home-remote.env.example deploy/home-remote.env

# Tailscale IPv4 of the Linux home machine (see deploy/TAILSCALE.md)
HOME_TAILSCALE_IP=100.111.129.27

# SSH host alias from ~/.ssh/config (see deploy/ssh/config.example)
HOME_SSH_HOST=job-crawler-home

# Local URLs — use defaults when tunnel-home-services.sh is running
JOB_INGESTION_URL=http://127.0.0.1:8000
NOTIFICATION_WORKER_URL=http://127.0.0.1:8002
