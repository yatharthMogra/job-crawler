DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobingestion
# Tiered fetch scheduler (optional — omit to use built-in defaults)
FETCH_SCHEDULE_JSON={
    "tick_minutes":10,
    "batch_cap":200,
    "default_fetch_tier":2,
    "waas":{
        "dedicated_job":true,
        "interval_minutes":30
    },
    "intervals":{
        "workatastartup":{"1":30},
        "greenhouse":{"1":45,"2":180,"3":720},
        "lever":{"1":45,"2":180,"3":720},
        "ashby":{"1":120,"2":480,"3":1440},
        "workday":{"1":240,"2":720,"3":2880},
        "oracle_hcm":{"1":360,"2":1440,"3":2880},
        "icims":{"1":360,"2":1440,"3":2880},
        "workable":{"1":180,"2":720,"3":1440}
    },
    "throttles":{
        "default_concurrency":8,
        "platforms":{
            "ashby":{"concurrency":1,"inter_company_seconds":3},
            "workday":{"concurrency":3,"inter_company_seconds":1},
            "oracle_hcm":{"concurrency":2},
            "icims":{"concurrency":1}
        }
    }
}
# Pause or throttle fetch when enrichment backlog is too large (queued + cooldown + in_progress).
FETCH_BACKPRESSURE_ENABLED=true
FETCH_BACKPRESSURE_QUEUE_THRESHOLD=2000
# skip_tiers = drop configured tiers from batch; halt_all = skip entire fetch tick
FETCH_BACKPRESSURE_MODE=skip_tiers
FETCH_BACKPRESSURE_SKIP_TIERS=3
# Under halt_all, WAAS dedicated job still runs when true
FETCH_BACKPRESSURE_ALLOW_WAAS=true
MAX_CONSECUTIVE_FAILURES_BEFORE_ALERT=3
CONSECUTIVE_MISSES_BEFORE_INACTIVE=3
LLM_PROVIDER=gemini
# Comma-separated keys for parallel enrichment workers (throughput ~ N × ENRICHMENT_LLM_MAX_RPM).
# Falls back to GEMINI_API_KEY when unset (single worker).
GEMINI_API_KEYS=
GEMINI_API_KEY=
# Optional cap on workers; defaults to number of keys in GEMINI_API_KEYS.
ENRICHMENT_WORKER_COUNT=
GEMINI_MODEL=gemini-3.1-flash-lite
EXTRACTION_VERSION=v10
COMPANY_ENRICHMENT_REFRESH_DAYS=30
COMPANY_ENRICHMENT_BATCH_SIZE=10
OPPORTUNITY_SCORE_FRESHNESS_DECAY=0.01
COMP_FLOOR=40000
COMP_CEILING=250000
ALERTS_FILE_PATH=./alerts.json
# Optional shared secret for POST /ingest/tesla/* (browser bridge). Leave empty for local dev.
TESLA_INGEST_TOKEN=
INGESTION_STATS_FILE_PATH=exports/ingestion_stats.json
INGESTION_STATS_INTERVAL_MINUTES=5
ENRICHMENT_MICRO_BATCH_SIZE=12
# Hold small batches until min size is met (reduces wasteful singleton API calls).
ENRICHMENT_MIN_BATCH_ENABLED=true
ENRICHMENT_MIN_BATCH_SIZE=6
# Fire undersized batches when any job has waited this long in queue (seconds).
ENRICHMENT_MIN_BATCH_BYPASS_WAIT_SECONDS=1800
ENRICHMENT_WINDOW_SECONDS=45
ENRICHMENT_MAX_BATCHES_PER_WINDOW=12
ENRICHMENT_MAX_JOBS_PER_WINDOW=64
ENRICHMENT_LLM_MAX_RPM=10
# Keep total RPM near daily quota: keys × 500 req/day ≈ keys × 0.35 req/min sustained.
# Example: 10 keys → ~3–4 RPM per worker, not 12.
ENRICHMENT_COOLDOWN_SECONDS=120
ENRICHMENT_MAX_RETRIES=3
# Per-worker Gemini capacity (one GCP project per key in GEMINI_API_KEYS).
ENRICHMENT_WORKER_DAILY_API_CALL_LIMIT=500
# Matches Google RPD reset at midnight Pacific (= 3 AM Eastern).
ENRICHMENT_WORKER_DAILY_RESET_TIME=00:00
ENRICHMENT_WORKER_DAILY_RESET_TIMEZONE=America/Los_Angeles
ENRICHMENT_WORKER_DAILY_FLUSH_INTERVAL=50
# RPM/TPM 429 backoff: 60s, 120s, 240s, … capped at max. After backoff, probe with 1 batch.
ENRICHMENT_WORKER_RATE_LIMIT_INITIAL_BACKOFF_SECONDS=60
ENRICHMENT_WORKER_RATE_LIMIT_BACKOFF_MULTIPLIER=2
ENRICHMENT_WORKER_RATE_LIMIT_MAX_BACKOFF_SECONDS=600
# Manual POST /jobs/{id}/enrich bypasses worker capacity tracking.
ENRICHMENT_MAX_INPUT_TOKENS_PER_BATCH=14000
ENRICHMENT_WINDOW_TOKEN_BUDGET=200000
ENRICHMENT_TOKEN_ESTIMATION_STRATEGY=chars
LOG_LEVEL=INFO
# Max seconds to wait for enrichment workers during graceful shutdown (lifespan cleanup).
SHUTDOWN_WORKER_TIMEOUT_SECONDS=30
# Jobs posted more than this many days ago are rejected at fetch/pipeline/enrichment
# and removed by nightly cleanup. Match recommendation_service JOB_MAX_AGE_DAYS.
JOB_MAX_AGE_DAYS=7
# Global rate limit for all Ashby GraphQL requests from this process (jobs.ashbyhq.com).
ASHBY_HOST_RATE_PER_SECOND=1.5
ASHBY_HOST_BURST=3
# Re-fetch Ashby job detail even when listing metadata is unchanged after this many days.
ASHBY_FULL_REFRESH_DAYS=7
# Global rate limit for Eightfold SmartApply requests, keyed by api_host per tenant.
EIGHTFOLD_HOST_RATE_PER_SECOND=1.0
EIGHTFOLD_HOST_BURST=2
ARCHIVE_RETENTION_DAYS=100
CLEANUP_BATCH_SIZE=500
ARCHIVE_DIR=data/archives
YC_CRAWLER_EMAIL=
YC_CRAWLER_PASSWORD=
YC_DIRECTORY_PROBE_CONCURRENCY=5
YC_WAAS_ROLES=eng,ds,pm
# Company discovery (scripts/discover_companies_from_search.py) — optional
SERPAPI_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# Enqueue notification_job_events when jobs complete enrichment (Company Watch)
COMPANY_WATCH_EVENTS_ENABLED=true
# Company logos: local writes PNGs to web/public/logos/companies (served at /logos/companies/*)
COMPANY_LOGO_STORAGE_BACKEND=local
COMPANY_LOGO_LOCAL_DIR=../web/public/logos/companies
COMPANY_LOGO_PUBLIC_BASE_URL=/logos/companies
# Production: COMPANY_LOGO_STORAGE_BACKEND=azure + public container URL
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=company-icons
# COMPANY_LOGO_PUBLIC_BASE_URL=https://<account>.blob.core.windows.net/company-icons
# Legacy: COMPANY_LOGO_STORAGE_BACKEND=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=company-logos
# Hugging Face token for ATS embedding model downloads (sentence-transformers)
HF_TOKEN=
