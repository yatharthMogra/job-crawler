# Local development
NEXT_PUBLIC_PROFILE_API_URL=http://localhost:8001
NEXT_PUBLIC_RECOMMENDATION_API_URL=http://localhost:8002
# Set true to preview jobs + email alert settings UI without backend APIs
NEXT_PUBLIC_USE_MOCK_DATA=false

# Server-side profile API (BFF proxy + NextAuth callbacks)
PROFILE_API_URL=http://localhost:8001
PROFILE_API_KEY=dev-key-change-me

# Production (uncomment and set after Cloud Run / Vercel deploy)
# NEXT_PUBLIC_RECOMMENDATION_API_URL=https://recommendation-api-xxxxx.run.app
# PROFILE_API_URL=https://profile-api-xxxxx.run.app
# AUTH_URL=https://job-scout.dev

# Billing is owned by profile_service (Stripe Checkout + Customer Portal).
# Configure STRIPE_* on the profile Cloud Run service — not required in Vercel
# unless you add client-side Stripe.js later.
# Local webhook: stripe listen --forward-to localhost:8001/billing/webhook

# NextAuth / Google OAuth
# Google Cloud Console → Credentials → OAuth client → Authorized redirect URIs:
#   https://job-scout.dev/api/auth/callback/google
#   https://carrier-match-gcp.vercel.app/api/auth/callback/google  (legacy, remove after cutover)
#   http://localhost:3000/api/auth/callback/google  (local dev)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
