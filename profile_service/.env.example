DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobingestion
API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PYMUPDF_MIN_CHAR_THRESHOLD=100
EXTRACTION_VERSION=v1
CAPABILITY_TAXONOMY_VERSION=v1
# local (dev) | supabase (Cloud Run production)
RESUME_STORAGE_BACKEND=local
RESUME_STORAGE_PATH=./data/resumes
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes
LOG_LEVEL=INFO
# Email OTP (signup / sign-in verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Job Scout <noreply@example.com>
# Production (Cloud Run): add your Vercel URL
# CORS_ORIGINS=https://your-app.vercel.app
