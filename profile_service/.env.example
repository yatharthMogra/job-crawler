DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobingestion
API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
PYMUPDF_MIN_CHAR_THRESHOLD=100
EXTRACTION_VERSION=v1
CAPABILITY_TAXONOMY_VERSION=v1
# local (dev) | azure (Cloud Run production) | supabase (legacy)
RESUME_STORAGE_BACKEND=local
RESUME_STORAGE_PATH=./data/resumes
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes
LOG_LEVEL=INFO
# Email OTP (signup / sign-in verification) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Job Scout <notifications@job-scout.dev>
# Pub/Sub embedding requests (Cloud Run production)
GCP_PROJECT=
EMBEDDING_REQUESTS_TOPIC=embedding-requests
EMBEDDING_PUBLISH_ENABLED=true
# Production (Cloud Run): add your Vercel URL
# CORS_ORIGINS=https://your-app.vercel.app

# Stripe billing (test mode first — https://dashboard.stripe.com/test/apikeys)
